{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/Documents/Custom/ascii-art.txt",
    "color": {
      "1": "#CDFF00",
      "2": "#B8FF00", 
      "3": "#A3FF00",
      "4": "#8EFF00"
    }
  },
  "modules": [
    "title",

    {
      "type": "separator",
      "string": "─"
    },

    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;5;154m󰃟 ENVIRONMENT\u001b[0m"
    },
    { "type": "de", "key": "  DE" },
    { "type": "wm", "key": "  WM" },
    { "type": "theme", "key": "  Theme" },
    { "type": "icons", "key": "  Icons" },
    { "type": "terminal", "key": "  Terminal" },
    "break",

    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;5;154m󰘳 SOFTWARE\u001b[0m"
    },
    { "type": "os", "key": "  OS" },
    { "type": "kernel", "key": "  Kernel" },
    { "type": "shell", "key": "  Shell" },
    { "type": "packages", "key": "  Packages" },
    { "type": "uptime", "key": "  Uptime" },
    "break",

    {
      "type": "custom",
      "format": "\u001b[1m\u001b[38;5;154m󰍛 HARDWARE\u001b[0m"
    },
    { "type": "host", "key": "  Model" },
    { "type": "cpu", "key": "  CPU" },
    { "type": "gpu", "key": "  GPU" },
    { "type": "memory", "key": "  RAM" },
    { "type": "disk", "key": "  Storage" },
    { "type": "battery", "key": "  Battery" },
    "break"
    
  ]
}